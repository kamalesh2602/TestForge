# ==============================================================================
# TestForge - Local Development Environment Configuration
# ==============================================================================
# Copy this file to .env before starting Docker Compose:
#   cp .env.example .env
#
# Docker Compose will automatically read .env and supply these variables
# to the appropriate frontend and backend containers.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Frontend Configuration
# ------------------------------------------------------------------------------
# (Required) Browser-accessible API URL for the TestForge FastAPI backend.
# NOTE: This must use localhost or host IP (e.g., http://localhost:8000), NOT a
# Docker-internal container hostname like http://backend:8000, because requests
# are initiated directly from the user's web browser on the host machine.
VITE_API_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# 2. Backend & CORS Configuration
# ------------------------------------------------------------------------------
# (Optional) Port on which the backend server listens inside the container.
# Defaults to 8000.
PORT=8000

# (Required) Allowed frontend origin(s) for Cross-Origin Resource Sharing (CORS).
# Accepts a comma-separated list of origins. Include both localhost and 127.0.0.1
# to accommodate different local browser navigation habits.
FRONTEND_URL=http://localhost:5173,http://127.0.0.1:5173

# ------------------------------------------------------------------------------
# 3. Execution Sandboxing Engine
# ------------------------------------------------------------------------------
# (Required) Execution engine for running user code and test harnesses.
# Supported values:
#   - 'judge0' : Dispatches code to a Judge0 API instance (recommended for Compose).
#   - 'docker' : Requires the Docker socket mounted into the container (host-based).
EXECUTOR=judge0

# (Optional) Base URL for the Judge0 REST API instance.
# Defaults to the public Judge0 CE instance (https://ce.judge0.com) when unset.
JUDGE0_API_URL=https://ce.judge0.com

# (Optional) Judge0 language IDs (pre-configured for standard Judge0 CE instance).
# JUDGE0_JAVASCRIPT_LANGUAGE_ID=102
# JUDGE0_C_LANGUAGE_ID=103
# JUDGE0_CPP_LANGUAGE_ID=105
# JUDGE0_BASH_LANGUAGE_ID=46
# JUDGE0_GO_LANGUAGE_ID=60

# ------------------------------------------------------------------------------
# 4. AI-Powered Test Case Generation (Optional)
# ------------------------------------------------------------------------------
# TestForge will start up and run code execution normally without any AI keys.
# AI-powered test generation requires at least one configured provider key below.

# (Optional) Active LLM provider: 'gemini' (default) or 'openrouter'.
LLM_PROVIDER=gemini

# (Optional) Google Gemini API Key.
# Required only if LLM_PROVIDER is 'gemini' and you use the AI Test Generator.
GEMINI_API_KEY=

# (Optional) Gemini model name for test generation.
GEMINI_MODEL=gemini-3.6-flash

# (Optional) OpenRouter API Key.
# Used when LLM_PROVIDER is 'openrouter' or as secondary fallback.
OPENROUTER_API_KEY=
